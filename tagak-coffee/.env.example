# Copy this file to .env and fill in local values. .env is git-ignored.
# Never commit real credentials. Every variable below is read by the server.

# --- Core -------------------------------------------------------------------
# PostgreSQL connection. Local PostgreSQL is expected on port 5433 in this repo.
DATABASE_URL=postgres://localhost:5433/tagak
PORT=3000
# Public origin used for cookies, OAuth redirects and absolute links.
# Set this explicitly on any host that does not provide RENDER_EXTERNAL_URL or
# RAILWAY_PUBLIC_DOMAIN.
PUBLIC_BASE_URL=http://localhost:3000
# Optional: development | production. Production requires an HTTPS PUBLIC_BASE_URL.
# NODE_ENV=development

# --- Database safety and pooling --------------------------------------------
# Local development refuses remote database hosts unless this is explicitly true.
# Keep it unset for normal local work. Never set it in production.
ALLOW_REMOTE_DB=
# Maximum pg pool size. Leave empty for 10. Serverless hosts usually need 2-3.
DB_POOL_MAX=
# Optional session connection for LISTEN/NOTIFY if DATABASE_URL is a transaction pooler.
ORDER_LISTEN_DATABASE_URL=
# Optional PEM certificate for a database host whose CA is not publicly trusted.
DATABASE_CA_CERT=
# One-time migration connection for a direct/session connection.
MIGRATION_DATABASE_URL=
# Express trust proxy setting when running behind a reverse proxy (Render, etc.).
# Use 1 for a single proxy hop. Leave empty for direct local connections.
TRUST_PROXY=
# Cap on an SSE response lifetime in milliseconds. Empty/0 means no cap.
SSE_LIFETIME_MS=

# --- First Super Admin (used by `npm run db:seed`) --------------------------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Generate a separate 32-byte hex key for each deployment environment:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PIN_HMAC_KEY=

# --- Staff authentication ---------------------------------------------------
# local (default, email + password/PIN in this database) or supabase.
AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Optional Google staff sign-in -----------------------------------------
# See GOOGLE_SSO_SETUP.md. Disabled when both values are empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Xendit QR Ph (test mode only) -----------------------------------------
# Keep the production handler disabled unless a separate live configuration
# has been reviewed. ALLOW_PAYMENT_SIMULATION is for local/preview only.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_QR_ENABLED=false
XENDIT_DAILY_CHECKOUT_LIMIT=500
ALLOW_PAYMENT_SIMULATION=false

# --- Optional Supabase Storage ---------------------------------------------
# When SUPABASE_STORAGE_BUCKET is empty, uploads are written to server/uploads
# on local disk. Set all three values to use hosted object storage instead.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_STAGING_BUCKET=

# --- Disposable test database ----------------------------------------------
# reset-based tests only run against this localhost database.
TEST_DATABASE_URL=postgres://localhost:5433/tagak_test
